# =============================================================================
# Load balancer Nginx - répartit le trafic vers les instances web (Laravel)
# Géré par le rôle Ansible "nginx_lb" - NE PAS MODIFIER MANUELLEMENT
# =============================================================================
upstream {{ nginx_lb_upstream_name }} {
{% if nginx_lb_lb_method == 'least_conn' %}
    least_conn;
{% elif nginx_lb_lb_method == 'ip_hash' %}
    ip_hash;
{% endif %}
{% for server in nginx_lb_backend_servers %}
    server {{ server }}:{{ nginx_lb_backend_port }} max_fails=3 fail_timeout=30s;
{% endfor %}
}

server {
    listen {{ nginx_lb_listen_port }};
    server_name {{ nginx_lb_server_name }};

    # Vérification de santé du load balancer lui-même
    location {{ nginx_lb_health_check_path }} {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "OK\n";
    }

    location / {
        proxy_pass http://{{ nginx_lb_upstream_name }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout {{ nginx_lb_proxy_connect_timeout }};
        proxy_read_timeout {{ nginx_lb_proxy_read_timeout }};
    }
}

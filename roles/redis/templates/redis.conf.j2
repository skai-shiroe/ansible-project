# =============================================================================
# Configuration Redis - Géré par le rôle Ansible "redis"
# NE PAS MODIFIER MANUELLEMENT
# =============================================================================

############################### NETWORK #######################################
{% if redis_tls_enabled %}
# TLS : le port clair est désactivé
bind {{ redis_bind }}
port 0
tls-port {{ redis_tls_port }}
{% else %}
bind {{ redis_bind }}
port {{ redis_port }}
{% endif %}

############################### GENERAL #######################################
daemonize no
supervised no
pidfile {{ redis_pid_file }}
dir {{ redis_dir }}
dbfilename {{ redis_dbfilename }}
protected-mode {{ redis_protected_mode }}
loglevel {{ redis_loglevel }}
# Journalisation : pas de directive "logfile" ⇒ Redis journalise sur la sortie
# standard, reprise par systemd (consulter : journalctl -u {{ redis_service }}).
databases {{ redis_databases }}
{% if redis_socket | length > 0 %}

# Socket Unix (clients locaux uniquement)
unixsocket {{ redis_socket }}
unixsocketperm 700
{% endif %}

############################# PERSISTENCE #####################################
{% if redis_appendonly %}
appendonly yes
appendfilename "{{ redis_appendfilename }}"
{% else %}
appendonly no
{% endif %}

############################### SECURITY ######################################
{% if redis_password | length > 0 %}
requirepass {{ redis_password }}
masterauth {{ redis_password }}
{% else %}
# Aucun mot de passe défini : à réserv hors développement (variable
# `redis_password` / `vault_redis_password`)
{% endif %}

############################### MEMORY #########################################
maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}
